{
  "info": {
    "name": "CRM Platform — Admin + ClientZone Phase 2A",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://clientzone-platform-primecrm.onrender.com" },
    { "key": "clientToken", "value": "" },
    { "key": "staffToken", "value": "" }
  ],
  "item": [
    {
      "name": "ClientZone",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"fullName\": \"Phase2 Client\",\n  \"email\": \"phase2.client@apex.test\",\n  \"password\": \"secret123\",\n  \"phone\": \"+923009998877\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/leads"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.accessToken) pm.collectionVariables.set('clientToken', j.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"phase2.client@apex.test\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/auth/login"
          }
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"phase2.client@apex.test\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/auth/forgotpass"
          }
        },
        {
          "name": "Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"PASTE_resetToken_FROM_FORGOT\",\n  \"password\": \"secret456\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/auth/resetpass"
          }
        },
        {
          "name": "Change password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{clientToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"secret123\",\n  \"newPassword\": \"secret456\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/auth/changepass"
          }
        },
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/clientzone/lead/accounts"
          }
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Staff login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.accessToken) pm.collectionVariables.set('staffToken', j.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@apex.ai\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/auth/login"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/me"
          }
        },
        {
          "name": "List clients",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/clients"
          }
        },
        {
          "name": "List accounts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/accounts"
          }
        },
        {
          "name": "List transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/transactions"
          }
        }
      ]
    }
  ]
}
