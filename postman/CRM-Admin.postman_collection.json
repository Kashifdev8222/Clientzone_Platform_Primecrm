{
  "info": {
    "name": "CRM — Admin (Phase 2A + 2B)",
    "description": "Admin / staff APIs only.\n\nBase: https://clientzone-platform-primecrm.onrender.com\n\nDefault staff (after phase2a SQL):\nemail: admin@apex.ai\npassword: Admin@12345\n\nOrder:\n1 Staff login\n2 Clients / accounts / transactions\n3 Deposits list + mark COMPLETED",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://clientzone-platform-primecrm.onrender.com" },
    { "key": "staffToken", "value": "" },
    { "key": "depositId", "value": "" },
    { "key": "withdrawId", "value": "" },
    { "key": "documentId", "value": "" },
    { "key": "clientId", "value": "" },
    { "key": "ticketId", "value": "" },
    { "key": "meetingId", "value": "" },
    { "key": "departmentId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "1. Staff Auth (Phase 2A)",
      "item": [
        {
          "name": "1.1 Staff login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.accessToken) pm.collectionVariables.set('staffToken', j.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@apex.ai\",\n  \"password\": \"Admin@12345\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/auth/login"
          }
        },
        {
          "name": "1.2 Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/me"
          }
        }
      ]
    },
    {
      "name": "2. Clients & Accounts (Phase 2A)",
      "item": [
        {
          "name": "2.1 List clients",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.[0]?.id) pm.collectionVariables.set('clientId', j.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/clients"
          }
        },
        {
          "name": "2.2 Get client by id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/clients/{{clientId}}"
          }
        },
        {
          "name": "2.3 List accounts",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/accounts"
          }
        },
        {
          "name": "2.4 List transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/transactions"
          }
        }
      ]
    },
    {
      "name": "3. Deposits (Phase 2B)",
      "item": [
        {
          "name": "3.1 List pending deposits",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.[0]?.id) pm.collectionVariables.set('depositId', j.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/deposits?status=PENDING"
          }
        },
        {
          "name": "3.2 List all deposits",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/deposits"
          }
        },
        {
          "name": "3.3 Mark deposit COMPLETED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"note\": \"Manual reconcile mock payment\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/deposits/{{depositId}}/status",
            "description": "depositId is auto-set from 3.1, or paste id from ClientZone crypto deposit response"
          }
        },
        {
          "name": "3.4 Mark deposit FAILED",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"FAILED\",\n  \"note\": \"Payment not received\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/deposits/{{depositId}}/status"
          }
        }
      ]
    },
    {
      "name": "4. Withdrawals (Phase 2C)",
      "item": [
        {
          "name": "4.1 List pending withdrawals",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.[0]?.id) pm.collectionVariables.set('withdrawId', j.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/withdrawals?status=PENDING"
          }
        },
        {
          "name": "4.2 List all withdrawals",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/withdrawals"
          }
        },
        {
          "name": "4.3 Approve / mark COMPLETED (paid)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"COMPLETED\",\n  \"note\": \"Paid to client wallet\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/withdrawals/{{withdrawId}}/status"
          }
        },
        {
          "name": "4.4 Reject withdrawal (FAILED = refund)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"FAILED\",\n  \"note\": \"Rejected by finance\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/withdrawals/{{withdrawId}}/status"
          }
        }
      ]
    },
    {
      "name": "5. KYC (Phase 2D)",
      "item": [
        {
          "name": "5.1 List pending documents",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.[0]?.id) pm.collectionVariables.set('documentId', j.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/documents?status=PENDING"
          }
        },
        {
          "name": "5.2 List all documents",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/documents"
          }
        },
        {
          "name": "5.3 Approve document",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"APPROVED\",\n  \"reviewNote\": \"Looks good\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/documents/{{documentId}}/review"
          }
        },
        {
          "name": "5.4 Reject document",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"REJECTED\",\n  \"reviewNote\": \"Blurry image, please re-upload\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/documents/{{documentId}}/review"
          }
        }
      ]
    },
    {
      "name": "6. Support (Phase 2E)",
      "item": [
        {
          "name": "6.1 List departments",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.[0]?.id) pm.collectionVariables.set('departmentId', j.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/departments"
          }
        },
        {
          "name": "6.2 Create department",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Compliance\",\n  \"sortOrder\": 10\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/departments"
          }
        },
        {
          "name": "6.3 List tickets",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.[0]?.id) pm.collectionVariables.set('ticketId', j.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/tickets"
          }
        },
        {
          "name": "6.4 Get ticket",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/tickets/{{ticketId}}"
          }
        },
        {
          "name": "6.5 Staff reply",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Thanks — we are looking into this.\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/tickets/{{ticketId}}/comments"
          }
        },
        {
          "name": "6.6 Set ticket InProgress",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"InProgress\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/tickets/{{ticketId}}"
          }
        },
        {
          "name": "6.7 List meetings",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.[0]?.id) pm.collectionVariables.set('meetingId', j.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{staffToken}}" }],
            "url": "{{baseUrl}}/api/v1/admin/meetings"
          }
        },
        {
          "name": "6.8 Confirm meeting",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{staffToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/admin/meetings/{{meetingId}}"
          }
        }
      ]
    }
  ]
}
