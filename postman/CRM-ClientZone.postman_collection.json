{
  "info": {
    "name": "CRM — ClientZone (Phase 1 + 2A + 2B)",
    "description": "ClientZone APIs only.\n\nBase: https://clientzone-platform-primecrm.onrender.com\n\nOrder:\n1 Health\n2 Register / Login / Accounts / Transactions\n3 Passwords\n4 Deposits (payment methods, crypto, lemuxion)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "https://clientzone-platform-primecrm.onrender.com" },
    { "key": "clientToken", "value": "" },
    { "key": "accountId", "value": "" },
    { "key": "resetToken", "value": "" },
    { "key": "depositId", "value": "" },
    { "key": "sourceId", "value": "" },
    { "key": "withdrawId", "value": "" }
  ],
  "item": [
    {
      "name": "0. Health",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          }
        }
      ]
    },
    {
      "name": "1. Auth & Accounts (Phase 1)",
      "item": [
        {
          "name": "1.1 Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Demo\",\n  \"lastName\": \"Client\",\n  \"email\": \"demo.client@apex.test\",\n  \"phone\": \"+923001112233\",\n  \"country\": \"PK\",\n  \"language\": \"bm\",\n  \"customFields\": \"\",\n  \"username\": \"demo.client@apex.test\",\n  \"birthDate\": \"1995-01-15\",\n  \"password\": \"secret123\",\n  \"accounts\": [\n    {\n      \"groupName\": \"20900\\\\STANDART.USD\",\n      \"leverage\": 100,\n      \"isDemoAccount\": false\n    }\n  ],\n  \"brandId\": \"360e85c5-b81b-474d-87a2-a33fae141eca\",\n  \"businessUnitId\": \"ea8b30a5-57c4-4fe9-8fc1-b9260d9f93c1\",\n  \"isDemoAccount\": false,\n  \"tags\": [{ \"id\": \"bf05cca4-0ac8-4d59-aa1b-e07a5b31c969\" }],\n  \"notes\": [{ \"text\": \"ClientPortal-Website\" }]\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/leads"
          }
        },
        {
          "name": "1.2 Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.accessToken) pm.collectionVariables.set('clientToken', j.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.client@apex.test\",\n  \"password\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/auth/login"
          }
        },
        {
          "name": "1.3 List accounts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.[0]?.id) pm.collectionVariables.set('accountId', j.data[0].id);"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/clientzone/lead/accounts"
          }
        },
        {
          "name": "1.4 Rename account",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"My Trading Account\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/lead/accounts/{{accountId}}/name"
          }
        },
        {
          "name": "1.5 List transactions",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/clientzone/lead/account/transactions"
          }
        }
      ]
    },
    {
      "name": "2. Passwords (Phase 2A)",
      "item": [
        {
          "name": "2.1 Forgot password",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.resetToken) pm.collectionVariables.set('resetToken', j.data.resetToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.client@apex.test\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/auth/forgotpass"
          }
        },
        {
          "name": "2.2 Reset password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"password\": \"secret456\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/auth/resetpass"
          }
        },
        {
          "name": "2.3 Login after reset",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.accessToken) pm.collectionVariables.set('clientToken', j.data.accessToken);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo.client@apex.test\",\n  \"password\": \"secret456\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/auth/login"
          }
        },
        {
          "name": "2.4 Change password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"secret456\",\n  \"newPassword\": \"secret123\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/auth/changepass"
          }
        }
      ]
    },
    {
      "name": "3. Deposits (Phase 2B)",
      "item": [
        {
          "name": "3.1 Payment methods config",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/clientzone/payment-methods/config"
          }
        },
        {
          "name": "3.2 Crypto supported coins",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/clientzone/lead/account/transaction/crypto-pay/supported-coins"
          }
        },
        {
          "name": "3.3 Create CryptoPay deposit",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.id) pm.collectionVariables.set('depositId', j.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"payCurrency\": \"USDT\",\n  \"amount\": 100,\n  \"priceCurrency\": \"USD\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/lead/account/transaction/crypto-pay"
          }
        },
        {
          "name": "3.4 Create Lemuxion deposit",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"amount\": 50,\n  \"currency\": \"USD\",\n  \"description\": \"Test deposit\",\n  \"street\": \"Main Street 1\",\n  \"city\": \"Lahore\",\n  \"zip\": \"54000\",\n  \"state\": \"Punjab\",\n  \"country\": \"PK\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/lead/account/transaction/lemuxion-pay"
          }
        },
        {
          "name": "3.5 List transactions (after deposit)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/clientzone/lead/account/transactions"
          }
        },
        {
          "name": "3.6 List accounts (check balance after admin completes)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/clientzone/lead/accounts"
          }
        }
      ]
    },
    {
      "name": "4. Withdraw (Phase 2C)",
      "item": [
        {
          "name": "4.1 Create withdrawal source (crypto wallet)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.id) pm.collectionVariables.set('sourceId', j.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"Withdrawal\",\n  \"source\": \"Crypto\",\n  \"value\": \"USDT-TRC20 Wallet\",\n  \"extraData\": {\n    \"network\": \"TRC20\",\n    \"address\": \"TXmockWalletAddress123\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/transaction-source/create"
          }
        },
        {
          "name": "4.2 List withdrawal sources",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{clientToken}}" }],
            "url": "{{baseUrl}}/api/v1/clientzone/transaction-source/get"
          }
        },
        {
          "name": "4.3 Create withdraw request",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const j = pm.response.json();",
                  "if (j?.data?.id) pm.collectionVariables.set('withdrawId', j.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"accountId\": \"{{accountId}}\",\n  \"amount\": 25,\n  \"currency\": \"USD\",\n  \"type\": \"Withdraw\",\n  \"comment\": \"Withdraw Performed\",\n  \"transactionSourceId\": \"{{sourceId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/lead/account/transactions",
            "description": "Requires enough balance (deposit + admin COMPLETED first)"
          }
        },
        {
          "name": "4.4 Cancel withdraw",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Authorization", "value": "Bearer {{clientToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"Canceled\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/clientzone/lead/account/transactions/{{withdrawId}}"
          }
        }
      ]
    }
  ]
}
